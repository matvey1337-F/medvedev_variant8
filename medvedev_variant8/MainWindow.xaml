<Window x:Class="medvedev_variant8.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MainWindow" Height="550" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="#FF76E383">
            <TextBlock Text="Вариант №8" 
                       HorizontalAlignment="Center" 
                       VerticalAlignment="Center" 
                       FontSize="24" 
                       FontWeight="Bold"/>
        </Grid>

        <StackPanel Grid.Row="1" 
                    HorizontalAlignment="Center" 
                    VerticalAlignment="Center">
            <TextBlock Text="Выберите задание:" 
                       FontSize="18" 
                       HorizontalAlignment="Center" 
                       Margin="0,0,0,15"/>

            <Button x:Name="btnTask1" 
                    Content="Задача 1: Описание числа" 
                    Width="350" 
                    Height="45" 
                    Margin="0,8" 
                    FontSize="14"
                    Click="btnTask1_Click"/>

            <Button x:Name="btnTask2" 
                    Content="Задача 2: Длина самого длинного слова" 
                    Width="350" 
                    Height="45" 
                    Margin="0,8" 
                    FontSize="14"
                    Click="btnTask2_Click"/>

            <Button x:Name="btnTask3" 
                    Content="Задача 3: Точка с минимальной суммой расстояний" 
                    Width="350" 
                    Height="45" 
                    Margin="0,8" 
                    FontSize="14"
                    Click="btnTask3_Click"/>

            <Button x:Name="btnTask4" 
                    Content="Задача 4: Перестановка элементов массива" 
                    Width="350" 
                    Height="45" 
                    Margin="0,8" 
                    FontSize="14"
                    Click="btnTask4_Click"/>

            <Button x:Name="btnTask5" 
                    Content="Задача 5: Сортировка двумерного массива" 
                    Width="350" 
                    Height="45" 
                    Margin="0,8" 
                    FontSize="14"
                    Click="btnTask5_Click"/>
        </StackPanel>
    </Grid>
</Window>