<Window x:Class="medvedev_variant8.Pages.Task1Window"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Задача 1" Height="450" Width="600">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <TextBlock Grid.Row="0" 
                   TextWrapping="Wrap" 
                   FontSize="14" 
                   Margin="0,0,0,20">
            Задача 1: Дано целое число, лежащее в диапазоне от -999 до 999. 
            Вывести строку — словесное описание данного числа вида 
            "отрицательное двузначное число", "нулевое число", 
            "положительное однозначное число" и т.д.
        </TextBlock>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10">
            <TextBlock Text="Введите число (-999..999):" 
                       VerticalAlignment="Center" 
                       Width="200"/>
            <TextBox x:Name="txtInput" 
                     Width="150" 
                     Height="30" 
                     FontSize="14"/>
        </StackPanel>

        <Button Grid.Row="2" 
                x:Name="btnCalculate" 
                Content="Выполнить" 
                Width="150" 
                Height="40" 
                Margin="0,20" 
                FontSize="14"
                Click="btnCalculate_Click"/>


        <StackPanel Grid.Row="3" Margin="0,10">
            <TextBlock Text="Результат:" FontWeight="Bold"/>
            <TextBox x:Name="txtResult" 
                     Height="60" 
                     FontSize="14" 
                     IsReadOnly="True" 
                     TextWrapping="Wrap"
                     Margin="0,5,0,0"/>
        </StackPanel>

        <Button Grid.Row="4" 
                x:Name="btnBack" 
                Content="Назад в меню" 
                Width="150" 
                Height="40" 
                Margin="0,20" 
                FontSize="14"
                Click="btnBack_Click"/>
    </Grid>
</Window>
