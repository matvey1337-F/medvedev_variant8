<Window x:Class="medvedev_variant8.Pages.Task5Window"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Задача 5" Height="750" Width="900">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" TextWrapping="Wrap" FontSize="14" Margin="0,0,0,15">
            Задача 5: Сгенерировать массив M столбцов × N строк с числами 
            от -10 до 10. Отобразить. Отсортировать по возрастанию и убыванию, 
            вывести в двух таблицах. Найти минимум и максимум.
        </TextBlock>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,5">
            <TextBlock Text="Строк (N):" VerticalAlignment="Center" Width="100"/>
            <TextBox x:Name="txtRows" Width="80" Height="30" FontSize="14" Margin="0,0,20,0"/>
            <TextBlock Text="Столбцов (M):" VerticalAlignment="Center" Width="120"/>
            <TextBox x:Name="txtCols" Width="80" Height="30" FontSize="14"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal">
            <Button x:Name="btnGenerate" Content="Сгенерировать массив" 
                    Width="200" Height="40" Margin="0,15,10,0" FontSize="14" 
                    Click="btnGenerate_Click"/>
            <Button x:Name="btnBack" Content="Назад в меню" 
                    Width="200" Height="40" Margin="0,15,0,0" FontSize="14" 
                    Click="btnBack_Click"/>
        </StackPanel>

        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" 
                      HorizontalScrollBarVisibility="Auto" Margin="0,15,0,0">
            <StackPanel>
                <TextBlock Text="Исходный массив:" FontWeight="Bold" Margin="0,5,0,5"/>
                <TextBox x:Name="txtOriginal" FontFamily="Consolas" FontSize="14" 
                         IsReadOnly="True" TextWrapping="NoWrap" AcceptsReturn="True"
                         Height="120" VerticalScrollBarVisibility="Auto"/>

                <TextBlock Text="По возрастанию:" FontWeight="Bold" Margin="0,10,0,5"/>
                <TextBox x:Name="txtAsc" FontFamily="Consolas" FontSize="14" 
                         IsReadOnly="True" TextWrapping="NoWrap" AcceptsReturn="True"
                         Height="120" VerticalScrollBarVisibility="Auto"/>

                <TextBlock Text="По убыванию:" FontWeight="Bold" Margin="0,10,0,5"/>
                <TextBox x:Name="txtDesc" FontFamily="Consolas" FontSize="14" 
                         IsReadOnly="True" TextWrapping="NoWrap" AcceptsReturn="True"
                         Height="120" VerticalScrollBarVisibility="Auto"/>

                <TextBlock Text="Минимум и максимум:" FontWeight="Bold" Margin="0,10,0,5"/>
                <TextBox x:Name="txtMinMax" FontSize="14" IsReadOnly="True" 
                         TextWrapping="Wrap" Height="50"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>