<Window x:Class="medvedev_variant8.Pages.Task2Window"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Задача 2" Height="500" Width="600">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" 
                   TextWrapping="Wrap" 
                   FontSize="14" 
                   Margin="0,0,0,20">
            Задача 2: Дана строка, состоящая из русских слов, разделенных 
            пробелами (одним или несколькими). Определить длину самого 
            длинного слова.
        </TextBlock>

        <StackPanel Grid.Row="1" Margin="0,10">
            <TextBlock Text="Введите строку:"/>
            <TextBox x:Name="txtInput" 
                     Height="60" 
                     FontSize="14" 
                     TextWrapping="Wrap"
                     AcceptsReturn="True"
                     Margin="0,5,0,0"/>
        </StackPanel>

        <Button Grid.Row="2" 
                x:Name="btnCalculate" 
                Content="Выполнить" 
                Width="150" 
                Height="40" 
                Margin="0,20" 
                FontSize="14"
                Click="btnCalculate_Click"/>

        <StackPanel Grid.Row="3" Margin="0,10">
            <TextBlock Text="Результат:" FontWeight="Bold"/>
            <TextBox x:Name="txtResult" 
                     Height="60" 
                     FontSize="14" 
                     IsReadOnly="True" 
                     TextWrapping="Wrap"
                     Margin="0,5,0,0"/>
        </StackPanel>

        <Button Grid.Row="4" 
                x:Name="btnBack" 
                Content="Назад в меню" 
                Width="150" 
                Height="40" 
                Margin="0,20" 
                FontSize="14"
                Click="btnBack_Click"/>
    </Grid>
</Window>
